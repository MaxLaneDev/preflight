{
  "version": 1,
  "pipeline": {
    "stages": [
      {
        "id": "build",
        "command": {"program": "cc", "args": ["-Wall", "-Wextra", "-Werror", "main.c", "-o", "example.exe"], "timeout_seconds": 30},
        "outputs": {"app": {"path": "example.exe", "type": "executable"}}
      },
      {
        "id": "tests",
        "kind": "test",
        "needs": ["build"],
        "command": {"program": "${artifact.build.app}", "args": [], "timeout_seconds": 10}
      }
    ]
  }
}
